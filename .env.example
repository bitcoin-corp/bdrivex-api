# bdrivex-api. Real values live in the server env only (pm2 ecosystem / Hetzner), never in git.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/srv/bdrivex/data
SESSION_SECRET=your-32-plus-char-secret-here
ALLOWED_ORIGINS=https://bdrivex.com,https://www.bdrivex.com
TRUST_PROXY=1
QUOTA_BYTES=1073741824
MAX_FILE_BYTES=2147483648
LINK_MAX_DAYS=30
UPLOAD_BYTES_PER_DAY=10737418240
LINK_EGRESS_BYTES_PER_DAY=53687091200
# invite (default in production) = only ALLOWED_KEYS can sign in; open = any bWalletX.
SIGNUP=invite
ALLOWED_KEYS=owner-identity-key,team-key,jon-key
# Free storage per wallet, and more for named wallets (identityKey:bytes,...).
QUOTA_OVERRIDES=
# Where blobs live: fs (default, DATA_DIR/blobs) or s3 (any S3-compatible bucket; Hetzner Object Storage is the target).
BLOB_STORE=fs
# BLOB_STORE=s3 needs all of these but S3_PREFIX. Endpoint without the bucket; path-style URLs are used.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
# Nightly second copy (scripts/mirror-to-b2.mjs). Backblaze B2's S3-compatible API.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_PREFIX=
