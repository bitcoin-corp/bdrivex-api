# bdrivex-api. Real values live in the server's env file only (the one pm2 loads with node --env-file;
# scripts/deploy-s3.sh prints where it is), never in git.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/path/to/bdrivex/data
SESSION_SECRET=your-32-plus-char-secret-here
# Production default when unset: bdrivex.com, www.bdrivex.com, bstorex.com, www.bstorex.com.
ALLOWED_ORIGINS=https://bdrivex.com,https://www.bdrivex.com,https://bstorex.com,https://www.bstorex.com
TRUST_PROXY=1
QUOTA_BYTES=1073741824
MAX_FILE_BYTES=2147483648
LINK_MAX_DAYS=30
UPLOAD_BYTES_PER_DAY=10737418240
LINK_EGRESS_BYTES_PER_DAY=53687091200
# invite (default in production) = only ALLOWED_KEYS can sign in; open = any bWalletX.
SIGNUP=invite
ALLOWED_KEYS=owner-identity-key,team-key,jon-key
# Free storage per wallet, and more for named wallets (identityKey:bytes,...).
QUOTA_OVERRIDES=
# Where blobs live: fs (default, DATA_DIR/blobs) or s3 (any S3-compatible bucket; Hetzner Object Storage is the target).
BLOB_STORE=fs
# BLOB_STORE=s3 needs all of these but S3_PREFIX. Endpoint without the bucket; path-style URLs are used.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=bcorp-bdrivex-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=blobs/
# How often blob deletes the bucket refused are retried (ms, default 10 minutes).
BLOB_DELETE_RETRY_MS=600000
# Retention (README "Reports, legal hold and retention"): report records 3 years, reporter IPs hashed after 30 days,
# revoked/expired links scrubbed of who they were for after 7 days. Checked every HOUSEKEEPING_MS (1 hour).
REPORT_KEEP_DAYS=1096
REPORT_IP_HASH_DAYS=30
LINK_SCRUB_DAYS=7
HOUSEKEEPING_MS=3600000
# Nightly second copy (scripts/mirror-to-b2.mjs). Backblaze B2's S3-compatible API.
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_PREFIX=
